{
    admin off
    auto_https disable_redirects
    skip_install_trust
    servers {
        protocols h1 h2
    }
}

https://pulse.local:8443 {
    bind {$PULSE_LAN_IP} 127.0.0.1
    tls internal

    @wifi remote_ip {$PULSE_LAN_CIDR} 127.0.0.1/32
    handle @wifi {
        reverse_proxy 127.0.0.1:3000 {
            header_up -CF-Connecting-IP
            header_up X-Forwarded-For {remote_host}
        }
    }
    handle {
        respond "Current Wi-Fi network only" 403
    }
}
